#!/bin/bash
#PBS -N uc_s2s_finetune
#PBS -A <project_code>
#PBS -q gpu-a100
#PBS -l select=2:ncpus=64:ngpus=4:mem=480GB
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o logs/train_finetune.log

### ── Environment ────────────────────────────────────────────────────────────
module purge
module load ncarenv/23.09 cuda/12.2 cudnn/8.9.7 nccl/2.19.3

source activate <conda_env>

### ── Paths ───────────────────────────────────────────────────────────────────
UC_S2S=/glade/work/bgong/physicsnemo/examples/weather/uc_s2s
DATA_DIR=/glade/derecho/scratch/bgong/era5
CKPT_DIR=/glade/derecho/scratch/bgong/uc_s2s/checkpoints/finetune

# Frozen backbone checkpoints (required — same as used for diffusion training)
CKPT_VAE=/glade/derecho/scratch/bgong/uc_s2s/checkpoints/det/best_ckpt_vae.tar
CKPT_DET=/glade/derecho/scratch/bgong/uc_s2s/checkpoints/det/best_ckpt_det.tar

# Pre-trained SI/diffusion checkpoint to fine-tune from (required)
CKPT_DIFF=/glade/derecho/scratch/bgong/uc_s2s/checkpoints/diffusion/best_ckpt_diff.tar

# Optional: resume an interrupted fine-tune run
CKPT_FINETUNE=null

mkdir -p $CKPT_DIR
mkdir -p $UC_S2S/logs

cd $UC_S2S

### ── Distributed config ─────────────────────────────────────────────────────
NNODES=$(sort -u $PBS_NODEFILE | wc -l)
NGPUS_PER_NODE=4
MASTER_ADDR=$(head -1 $PBS_NODEFILE)
MASTER_PORT=29500

### ── Launch ─────────────────────────────────────────────────────────────────
torchrun \
    --nnodes=$NNODES \
    --nproc_per_node=$NGPUS_PER_NODE \
    --rdzv_backend=c10d \
    --rdzv_endpoint=${MASTER_ADDR}:${MASTER_PORT} \
    train_finetune_rollout.py \
    data_dir=$DATA_DIR \
    checkpoint_dir=$CKPT_DIR \
    checkpoint_path_vae_c1=$CKPT_VAE \
    checkpoint_path_det=$CKPT_DET \
    checkpoint_path_diff=$CKPT_DIFF \
    finetune_ckpt=$CKPT_FINETUNE \
    resuming=false
