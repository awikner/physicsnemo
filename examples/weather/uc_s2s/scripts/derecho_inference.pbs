#!/bin/bash
#PBS -N uc_s2s_infer
#PBS -A <project_code>
#PBS -q gpu-a100
#PBS -l select=1:ncpus=64:ngpus=4:mem=480GB
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o logs/inference.log

### ── Environment ────────────────────────────────────────────────────────────
module purge
module load ncarenv/23.09 cuda/12.2 cudnn/8.9.7 nccl/2.19.3

source activate <conda_env>

### ── Paths ───────────────────────────────────────────────────────────────────
UC_S2S=/glade/work/bgong/physicsnemo/examples/weather/uc_s2s
DATA_DIR=/glade/derecho/scratch/bgong/era5
OUTPUT_DIR=/glade/derecho/scratch/bgong/uc_s2s/inference_output

# Frozen backbone checkpoints (required)
CKPT_VAE=/glade/derecho/scratch/bgong/uc_s2s/checkpoints/det/best_ckpt_vae.tar
CKPT_DET=/glade/derecho/scratch/bgong/uc_s2s/checkpoints/det/best_ckpt_det.tar

# SI/diffusion checkpoint (required)
CKPT_DIFF=/glade/derecho/scratch/bgong/uc_s2s/checkpoints/diffusion/best_ckpt_diff.tar

# Optional: fine-tuned rollout checkpoint (set to null to skip)
CKPT_FINETUNE=null

mkdir -p $OUTPUT_DIR
mkdir -p $UC_S2S/logs

cd $UC_S2S

### ── Distributed config ─────────────────────────────────────────────────────
NNODES=$(sort -u $PBS_NODEFILE | wc -l)
NGPUS_PER_NODE=4
MASTER_ADDR=$(head -1 $PBS_NODEFILE)
MASTER_PORT=29500

### ── Launch ─────────────────────────────────────────────────────────────────
torchrun \
    --nnodes=$NNODES \
    --nproc_per_node=$NGPUS_PER_NODE \
    --rdzv_backend=c10d \
    --rdzv_endpoint=${MASTER_ADDR}:${MASTER_PORT} \
    inference.py \
    data_dir=$DATA_DIR \
    output_dir=$OUTPUT_DIR \
    checkpoint_path_vae_c1=$CKPT_VAE \
    checkpoint_path_det=$CKPT_DET \
    checkpoint_path_diff=$CKPT_DIFF \
    checkpoint_path_finetune=$CKPT_FINETUNE
