#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2026 The University of Chicago.
# SPDX-License-Identifier: Apache-2.0
#
# Derecho develop-queue job: harmonize every MoWE expert archive into the
# unified schema under hindcasts_mowe/ (see tools/harmonize_hindcasts.py):
#   - graphcast  = graphcast_e2s + graphcast_wb2 merged (e2s wins), 0.25->1deg
#   - aifs_single_v2                                    0.25->1deg
#   - pangu_s2s / sfno_era5 subset (21 vars, 3D flattened), already 1deg
# Resumable via .harmonize_done sentinels; self-resubmits while unfinished.
#   qsub harmonize_derecho.pbs
# Expects $HOME/mowe_tools/{tools,datapipes} (harmonize_hindcasts.py,
# mowe_subset_variables.txt, datapipes/{regrid,variables,precip}.py).
#PBS -N mowe_harmonize
#PBS -A UCHI0014
#PBS -q develop
#PBS -l select=1:ncpus=64:mem=235GB
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /glade/derecho/scratch/awikner/hindcasts_mowe/harmonize.log

set -uo pipefail
module load conda
conda activate hindcast_conv

TOOLS="$HOME/mowe_tools/tools"
DSI=/glade/derecho/scratch/awikner/hindcasts_dsi/zarr
CONS=/glade/derecho/scratch/awikner/physicsnemo-zarr/hindcasts
OUT=/glade/derecho/scratch/awikner/hindcasts_mowe
REF=/glade/derecho/scratch/awikner/physicsnemo-zarr/imerg/2001.zarr
NP="${NP:-8}"
DEPTH="${DEPTH:-0}"
MAX_RESUBMITS="${MAX_RESUBMITS:-8}"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4

mkdir -p "$OUT"
echo "[$(date)] harmonize start host=$(hostname) NP=$NP depth=$DEPTH"
rc=0

python "$TOOLS/harmonize_hindcasts.py" --source dsi --model graphcast \
    --src-root "$DSI/graphcast_e2s" --src-root "$DSI/graphcast_wb2" \
    --src-label e2s --src-label wb2 \
    --out-root "$OUT" --ref-store "$REF" --n-workers "$NP" \
    --commit "${COMMIT:-unknown}" || rc=1

python "$TOOLS/harmonize_hindcasts.py" --source dsi --model aifs_single_v2 \
    --src-root "$DSI/aifs_single_v2" \
    --out-root "$OUT" --ref-store "$REF" --n-workers "$NP" \
    --commit "${COMMIT:-unknown}" || rc=1

for M in pangu_s2s sfno_era5; do
    python "$TOOLS/harmonize_hindcasts.py" --source consolidated --model "$M" \
        --src-root "$CONS/$M" \
        --variables-file "$TOOLS/mowe_subset_variables.txt" \
        --out-root "$OUT" --ref-store "$REF" --n-workers "$NP" \
        --commit "${COMMIT:-unknown}" || rc=1
done

total=100   # 25 graphcast + 25 aifs_v2 + 25 pangu + 25 sfno
done_n=$(ls "$OUT/.harmonize_done"/*.done 2>/dev/null | wc -l)
echo "[$(date)] harmonize pass complete rc=$rc ($done_n/$total stores done)"

if [ "$done_n" -lt "$total" ] && [ "$DEPTH" -lt "$MAX_RESUBMITS" ]; then
    echo "[$(date)] resubmitting (depth $((DEPTH + 1)))"
    qsub -v "NP=$NP,DEPTH=$((DEPTH + 1)),MAX_RESUBMITS=$MAX_RESUBMITS,COMMIT=${COMMIT:-unknown}" \
        "$TOOLS/harmonize_derecho.pbs"
fi
