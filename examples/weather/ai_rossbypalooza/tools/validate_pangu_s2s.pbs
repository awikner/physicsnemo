set -uo pipefail
cd /glade/work/awikner/physicsnemo/tools/checkpoint_translation
module load ncarenv cuda python 2>/dev/null || true
source /glade/work/awikner/physicsnemo/.venv/bin/activate
export HDF5_USE_FILE_LOCKING=FALSE
export VALIDATE_S2S_CKPT=/glade/work/awikner/PanguWeather/v2.0/results/S2S/2000/training_checkpoints/best_ckpt.tar
