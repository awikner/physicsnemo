#
# Ablation ladder rungs A0, A1 and A2-L on the sst_pred contract, batch 40 on
# Polaris (10 nodes x 4 ranks, per-rank batch 1), in-harness. One script for
# all rungs so that they differ only in the model/loss line:
#
#   ABL=a0   ERDM v2 loss (loss/erdm_v2.yaml, byte-mirror of upstream's
#            ERDM_sst_pred scheduler) on model/amip_erdm_sst_pred (single head)
#   ABL=a1   RSI in the exact ERDM reduction (loss/rsi_a1.yaml) on
#            model/amip_rsi_sst_pred (two heads, H1 inert)
#   ABL=a0hn  A0 plus the high-noise loss boost (loss/erdm_v2_hn.yaml): the
#            corrected member of the 2026-09-15 pair. See that config for the
#            measurement -- A0 matched upstream's TOTAL loss at epoch 17 while
#            its day-10 RMSE was 2.3x worse, the deficit confined to the two
#            highest-sigma window slots, which carry under 30% of the weight.
#   ABL=a2lhn A2-L plus the same boost in sigma_eff units (loss/rsi_a2l_hn.yaml).
#   ABL=a2l  RSI with the lag-W sample anchor (loss/rsi_a2l.yaml, proposal
#            v0.2: anchor_lag 6, state head + EDM readout, W-step noise
#            scales sigma_c_sstpred153_lag6.pt) on model/amip_rsi_sst_pred.
#            Each sample carries 2W = 12 state frames; run it with
#            ABL_RECIPE=bundle (the recipe the lag-1 A2 bundle run reached
#            batch-4 loss parity with). Prerequisite: the lag-6 artifact under
#            $AI_ROSSBY_DATA/norm_stats (make_rsi_delta_scales.py --lag 6).
#
# Recipe (ABL_RECIPE, default "upstream", chosen 2026-09-10): upstream
# amip_v2's ERDM_sst_pred optimizer scaled to batch 40 -- base lr 5e-4 =
# 5e-5 x 10 (linear scaling), Muon group x10, Muon momentum 0.95 (upstream's),
# weight decay 0.01 on both groups, StepLR 0.95 per epoch (upstream's
# schedule), fp32 + TF32 matmuls (upstream's 32-true), EMA decay 0.99
# (= upstream's 0.999 per 10 updates). The ONE deviation from upstream's form
# is a 1-epoch linear warmup in front of the StepLR decay: upstream's peak was
# 10x lower, the linearly scaled peak has only ever been run WITH a warmup,
# and the first epoch is where a large-batch run diverges. ABL_RECIPE=bundle
# gives the A2 bundle run's recipe instead (warmup + cosine to 5e-5 over the
# horizon, momentum 0.85). Both: activation checkpointing on the first 14 of
# 20 levels, two epochs per 3 h link; every link resumes from the last
# checkpoint pair and exits when the target epoch exists. Env knobs:
#
#   ABL          a0 | a0hn | a1 | a2l | a2lhn (required)
#   ABL_RECIPE   upstream (default) | bundle
#   ABL_TARGET   last epoch (default 24)
#   ABL_CKPT     checkpoint dir (default checkpoints_${ABL}_sstpred_b40)
#   ABL_SEED     training seed (default 0, the A2 bundle run's)
#   ABL_VAL_EVERY validation cadence in epochs (default 1, as upstream)
#   ABL_NODES    expected node count (default 10; 1 for a debug smoke run)
#   ABL_CHAIN    remaining links to submit AFTER this one (default 0). A link
#                with ABL_CHAIN=N submits ONE successor (afterany on itself,
#                ABL_CHAIN=N-1) once it owns the lock, so a run occupies at
#                most one queued slot instead of N -- the `small` queue caps a
#                user at ~12 queued+held jobs, which two 12-link chains plus
#                the controls would exceed. Submit a whole run with
#                `ABL_CHAIN=11` on a single qsub.
#   ABL_LOSS_DIAG per-slot loss decomposition every N batches (default 0 =
#                off): exports ERDM_LOSS_DIAG / RSI_LOSS_DIAG, which log
#                sigma (or sigma_eff), the loss weight and the weighted loss
#                per window slot. This is what the hn_* values are tuned on.
#   ABL_MOMENTUM Muon momentum (default 0.95). Until 2026-09-15 this knob
#                never reached the optimizer (train.py::_flatten_optimizer_cfg
#                dropped it), so a0/a1/a2l at BOTH recipes trained at the 0.95
#                package default -- the `bundle` label did not imply 0.85. The
#                default here is therefore 0.95 for both recipes, so fixing the
#                plumbing changes nothing for the in-flight chains; pass 0.85
#                explicitly to get the bundle recipe's intended value.
#   ABL_MAX_ITERS cap the stage at this many batches per epoch (default 0 =
#                off): a smoke run then reaches the epoch-end checkpoint and
#                the in-training rollout validation within its 30 minutes
#   ABL_EXTRA    extra Hydra overrides, "|"-separated (qsub -v cannot carry
#                commas or spaces), e.g. to score an UPSTREAM checkpoint with
#                the in-training validator: point ABL_CKPT at a dir holding
#                RollingDiTWrapper.0.<N>.mdlus, ABL_TARGET=N+1 ABL_MAX_ITERS=1
#                ABL_EXTRA="++training.optimizer.lr=1e-12|++training.ema.enabled=false"
#   ABL_RETRY    internal, counts preflight/blacklist resubmissions
#
# Exit codes: 0 done/nothing to do, 1 config, 3 bad allocation (resubmitted
# unless ABL_RETRY reached 4), 4 deferred behind the live trainer of the same
# checkpoint dir ($CKPT/.train_lock; resubmitted with afterany on it).
#
#PBS -A lighthouse-uchicago
#PBS -q prod
#PBS -l select=10:system=polaris
#PBS -l walltime=02:59:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -j oe
#PBS -N rsi-abl
set -uo pipefail
R=/eagle/lighthouse-uchicago/members/awikner/physicsnemo-rsi
cd "$R"
source "$R/polaris_env.sh"
export HYDRA_FULL_ERROR=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
echo "TMPDIR(job)=${TMPDIR:-unset}"
export TMPDIR=/tmp   # forkserver DataLoader socket path limit (see polaris_rsi_ft_phase5.pbs)
J=${PBS_JOBID%%.*}
ABL=${ABL:?set ABL=a0, a1 or a2l}
TARGET=${ABL_TARGET:-24}
CKPT=${ABL_CKPT:-checkpoints_${ABL}_sstpred_b40}
SEED=${ABL_SEED:-0}
VAL_EVERY=${ABL_VAL_EVERY:-1}
RECIPE=${ABL_RECIPE:-upstream}
MAX_ITERS=${ABL_MAX_ITERS:-0}
MOMENTUM=${ABL_MOMENTUM:-0.95}
CHAIN=${ABL_CHAIN:-0}
LOSS_DIAG=${ABL_LOSS_DIAG:-0}
export ERDM_LOSS_DIAG=$LOSS_DIAG   # read at import by erdm.py / rsi.py
export RSI_LOSS_DIAG=$LOSS_DIAG
EXTRA_RAW=${ABL_EXTRA:-}
EPOCHS_PER_LINK=2
EXPECT_NODES=${ABL_NODES:-10}
case "$ABL" in
  a0)    MODEL=amip_erdm_sst_pred; LOSS=erdm_v2;    RUN=erdm_sstpred_a0_b40 ;;
  a0hn)  MODEL=amip_erdm_sst_pred; LOSS=erdm_v2_hn; RUN=erdm_sstpred_a0hn_b40 ;;
  a1)    MODEL=amip_rsi_sst_pred;  LOSS=rsi_a1;     RUN=rsi_sstpred_a1_b40 ;;
  a2l|a2lhn)
         MODEL=amip_rsi_sst_pred;  RUN=rsi_sstpred_${ABL}_b40
         if [ "$ABL" = a2lhn ]; then LOSS=rsi_a2l_hn; else LOSS=rsi_a2l; fi
         if [ ! -f "$AI_ROSSBY_DATA/norm_stats/sigma_c_sstpred153_lag6.pt" ]; then
           echo "FATAL: $ABL needs $AI_ROSSBY_DATA/norm_stats/sigma_c_sstpred153_lag6.pt (make_rsi_delta_scales.py --lag 6 --contract sst_pred)"; exit 1
         fi ;;
  *) echo "FATAL: ABL must be a0, a0hn, a1, a2l or a2lhn, got '$ABL'"; exit 1 ;;
esac
mkdir -p "$CKPT"
GC_LEVELS=$(cat "$CKPT/grad_checkpoint_levels" 2>/dev/null || echo 14)
PPN=4
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
NRANKS=$((NNODES * PPN))
export GPUS_PER_NODE=$PPN
export MASTER_ADDR=$(head -1 "$PBS_NODEFILE")
export MASTER_PORT=29950
echo "=== $(date) ${NNODES} nodes / ${NRANKS} ranks | rung $ABL: model=$MODEL loss=$LOSS | recipe $RECIPE | ckpt $CKPT | target $TARGET | seed $SEED | gc_levels $GC_LEVELS ==="
[ "$NNODES" -eq "$EXPECT_NODES" ] || { echo "FATAL: expected $EXPECT_NODES nodes, got $NNODES"; exit 1; }
DONE=$(ls "$CKPT"/RollingDiTWrapper.0.*.mdlus 2>/dev/null | sed -E 's/.*\.0\.([0-9]+)\.mdlus$/\1/' | sort -n | tail -1)
DONE=${DONE:-0}
if [ "$DONE" -ge "$TARGET" ]; then echo "already at ${DONE}/${TARGET} -- nothing to do"; exit 0; fi
NEPOCH=$((DONE + EPOCHS_PER_LINK)); [ "$NEPOCH" -gt "$TARGET" ] && NEPOCH=$TARGET
echo "=== resume: ${DONE} epochs done -> running through epoch ${NEPOCH} of ${TARGET} ==="

# --- node blacklist + GPU preflight, with self-resubmission (as in the Phase 5
# --- fine-tune script; x3003c0s25b0n0 GPU 2 killed three jobs in September).
blacklisted () {
  [ -f "$R/bad_nodes.txt" ] || return 1
  local hit
  hit=$(grep -Fxf <(grep -vE "^\s*(#|$)" "$R/bad_nodes.txt" | awk "{print \$1}") <(sort -u "$PBS_NODEFILE" | sed "s/\..*//"))
  [ -n "$hit" ] && { echo "allocation contains blacklisted host(s): $hit"; return 0; }
  return 1
}
preflight () {
  local out nok
  out=$(timeout 300 mpiexec -n "$NRANKS" --ppn "$PPN" --hostfile "$PBS_NODEFILE" --cpu-bind depth -d 8 \
        bash hpc/scripts/polaris_rank_env.sh \
        python -c 'import os, socket, torch
try:
    x = torch.randn(2048, 2048, device="cuda"); y = (x @ x).sum().item(); torch.cuda.synchronize()
    print("GPUOK", socket.gethostname(), os.environ.get("LOCAL_RANK"))
except Exception as e:
    print("GPUBAD", socket.gethostname(), os.environ.get("LOCAL_RANK"), repr(e)[:160])' 2>&1)
  nok=$(grep -c "^GPUOK" <<< "$out")
  if [ "$nok" -ne "$NRANKS" ]; then
    echo "GPU preflight: only $nok/$NRANKS ranks ok"
    grep -vE "^GPUOK|Warning|warn\(" <<< "$out" | head -12
    grep "^GPUBAD" <<< "$out" | awk '{print $2, "gpu", $3}' | sort -u | tee -a "$R/bad_nodes_$(date +%Y%m%d).txt"
    return 1
  fi
  echo "GPU preflight: all $NRANKS ranks ok"
}
if blacklisted || ! preflight; then
  RETRY=${ABL_RETRY:-0}
  if [ "$RETRY" -lt 4 ]; then
    NEW=$(qsub -N "$PBS_JOBNAME" -v "ABL=$ABL,ABL_RECIPE=$RECIPE,ABL_TARGET=$TARGET,ABL_CKPT=$CKPT,ABL_SEED=$SEED,ABL_VAL_EVERY=$VAL_EVERY,ABL_NODES=$EXPECT_NODES,ABL_MAX_ITERS=$MAX_ITERS,ABL_MOMENTUM=$MOMENTUM,ABL_CHAIN=$CHAIN,ABL_LOSS_DIAG=$LOSS_DIAG,ABL_EXTRA=$EXTRA_RAW,ABL_RETRY=$((RETRY + 1))" "$R/polaris_ablation_train_b40.pbs" 2>&1)
    echo "bad GPU / blacklisted host in the allocation -- resubmitted as $NEW (retry $((RETRY + 1)))"
  fi
  exit 3
fi

# --- one trainer per checkpoint directory. A retry submitted above carries no
# --- dependency, so the chain's next link (afterany on THIS job) becomes
# --- eligible the moment this job exits and can start alongside the retry;
# --- on 2026-09-12/13 four copies of the A0 15->17 link and three of the A2-L
# --- 20->22 link trained the same directory at once. The lock holds the PBS
# --- id of the live trainer; a link that finds a live holder re-queues itself
# --- to run AFTER the holder (a minute of allocation, no epochs lost) and a
# --- lock whose job PBS no longer lists (walltime kill, node failure) is stale
# --- and taken over.
LOCK="$CKPT/.train_lock"
holder_alive () {   # $1 = PBS job id; true while PBS lists it in a non-finished state
  local st
  st=$(qstat -f "$1" 2>/dev/null | awk '/job_state/ {print $3}')
  [ -n "$st" ] && [ "$st" != F ] && [ "$st" != X ]
}
RESUB_VARS="ABL=$ABL,ABL_RECIPE=$RECIPE,ABL_TARGET=$TARGET,ABL_CKPT=$CKPT,ABL_SEED=$SEED,ABL_VAL_EVERY=$VAL_EVERY,ABL_NODES=$EXPECT_NODES,ABL_MAX_ITERS=$MAX_ITERS,ABL_MOMENTUM=$MOMENTUM,ABL_CHAIN=$CHAIN,ABL_LOSS_DIAG=$LOSS_DIAG,ABL_EXTRA=$EXTRA_RAW,ABL_RETRY=${ABL_RETRY:-0}"
if [ -f "$LOCK" ]; then
  HOLDER=$(awk '{print $1}' "$LOCK")
  if [ -n "$HOLDER" ] && [ "$HOLDER" != "$J" ] && holder_alive "$HOLDER"; then
    NEW=$(qsub -N "$PBS_JOBNAME" -W depend=afterany:"$HOLDER" -v "$RESUB_VARS" "$R/polaris_ablation_train_b40.pbs" 2>&1)
    case "$NEW" in
      *.polaris-pbs*) ;;
      *) # the holder finished between the check and the qsub: no dependency needed
         NEW=$(qsub -N "$PBS_JOBNAME" -v "$RESUB_VARS" "$R/polaris_ablation_train_b40.pbs" 2>&1) ;;
    esac
    echo "$CKPT is being trained by job $HOLDER -- deferred: resubmitted as $NEW to run after it"
    exit 4
  fi
  echo "stale lock from job ${HOLDER:-?} (not in PBS) -- taking over"
fi
echo "$J $(date -u +%FT%TZ) $(hostname)" > "$LOCK"
trap 'rm -f "$LOCK"' EXIT

# --- self-feeding chain. Submitted only once this link OWNS the lock, and
# --- with afterany on itself, so a run never has more than one queued job (the
# --- `small` queue caps queued+held per user, and the controls are using those
# --- slots). A deferred or bad-allocation link resubmits with the same CHAIN
# --- count via RESUB_VARS above, so the successor count is preserved.
if [ "$CHAIN" -gt 0 ]; then
  NEXT=$(qsub -N "$PBS_JOBNAME" -W depend=afterany:"$J" \
    -v "ABL=$ABL,ABL_RECIPE=$RECIPE,ABL_TARGET=$TARGET,ABL_CKPT=$CKPT,ABL_SEED=$SEED,ABL_VAL_EVERY=$VAL_EVERY,ABL_NODES=$EXPECT_NODES,ABL_MAX_ITERS=$MAX_ITERS,ABL_MOMENTUM=$MOMENTUM,ABL_CHAIN=$((CHAIN - 1)),ABL_LOSS_DIAG=$LOSS_DIAG,ABL_EXTRA=$EXTRA_RAW" \
    "$R/polaris_ablation_train_b40.pbs" 2>&1)
  echo "chain: submitted successor $NEXT ($((CHAIN - 1)) link(s) to follow it)"
fi

LR=5.0e-4        # LINEAR scaling: 5e-5 * 10 (safe only with the warmup)
case "$RECIPE" in
  upstream) SCHED=(++training.stages.0.scheduler.type=StepLR ++training.stages.0.scheduler.sl_gamma=0.95
                   ++training.stages.0.scheduler.num_warmup_epochs=1) ;;
  bundle)   SCHED=(++training.stages.0.scheduler.type=LinearWarmupCosineAnnealingLR
                   ++training.stages.0.scheduler.num_warmup_epochs=1
                   "++training.stages.0.scheduler.cosine_total_epochs=$TARGET"
                   ++training.stages.0.scheduler.eta_min=5.0e-5) ;;
  *) echo "FATAL: ABL_RECIPE must be upstream or bundle, got '$RECIPE'"; exit 1 ;;
esac
CAP=(); [ "$MAX_ITERS" -gt 0 ] && CAP=("++training.stages.0.max_iterations=$MAX_ITERS")
EXTRA=(); [ -n "$EXTRA_RAW" ] && { IFS="|" read -r -a EXTRA <<< "$EXTRA_RAW"; echo "extra overrides: ${EXTRA[*]}"; }
timeout 10200 mpiexec -n "$NRANKS" --ppn "$PPN" --hostfile "$PBS_NODEFILE" \
    --cpu-bind depth -d 8 \
    bash hpc/scripts/polaris_rank_env.sh \
    python examples/weather/ai_rossby/train_diffusion.py \
    --config-dir=examples/weather/ai_rossby/conf --config-name=config \
    "run_name=$RUN" \
    "model=$MODEL" "loss=$LOSS" loss.window_size=6 \
    dataset=amip_dailyavg_coarse_multiyear \
    training=amip_diffusion_bf16 validation=diffusion_rollout "seed=$SEED" \
    wandb.enabled=True wandb.mode=offline wandb.project=ai-rossby-rsi \
    "++dataset.zarr_path=$AI_ROSSBY_DATA/amip_dailyavg_coarse_train7914" \
    "++dataset.boundary_zarr_path=$AI_ROSSBY_DATA/amip_dailyavg_boundary_train7914" \
    "++dataset.mean_path=$AI_ROSSBY_DATA/amip_dailyavg_coarse/normalize_mean_dailyavg.nc" \
    "++dataset.std_path=$AI_ROSSBY_DATA/amip_dailyavg_coarse/normalize_std_dailyavg.nc" \
    ++dataset.sst_anomaly_channel=none ++dataset.scalar_forcing=none \
    ++dataset.normalize_constant_boundary=true \
    ++dataset.constant_boundary_stats=spatial \
    ++dataset.smooth_constant_lsm=true \
    ++training.amp=none ++training.matmul_precision=high \
    ++training.grad_checkpoint=true \
    "++training.grad_checkpoint_levels=$GC_LEVELS" \
    "++training.optimizer.lr=$LR" \
    ++training.optimizer.weight_decay=0.01 \
    ++training.optimizer.muon_lr_multiplier=10 \
    "++training.optimizer.muon_momentum=$MOMENTUM" \
    ++training.ema.decay=0.99 \
    "${SCHED[@]}" "${CAP[@]}" "${EXTRA[@]}" \
    "++training.max_epochs=$NEPOCH" "++training.stages.0.num_epochs=$NEPOCH" \
    "++validation.every_n_epochs=$VAL_EVERY" \
    "++validation.rollout.climatology.surface_path=$AI_ROSSBY_DATA/norm_stats/val_clim_coarse/climatology_surface.pt" \
    "++validation.rollout.climatology.upper_air_path=$AI_ROSSBY_DATA/norm_stats/val_clim_coarse/climatology_upper_air.pt" \
    "++validation.rollout.climatology.diagnostic_path=$AI_ROSSBY_DATA/norm_stats/val_clim_coarse/climatology_diagnostic.pt" \
    "++checkpoint_dir=$CKPT" \
    > "abl_${ABL}_${J}.log" 2>&1
echo "train exit=$? (124 = hit the timeout) ; === $(date) ==="
L="abl_${ABL}_${J}.log"
grep -am1 "world_size=" "$L"; grep -am1 "steps_per_epoch=" "$L"; grep -am1 "fast-forwarded" "$L"
grep -am1 "Scheduler initialized" "$L" | cut -c1-300
grep -am1 "anchor_lag=" "$L" | grep -o "anchor_lag=[^,]*, anchor_frames=[^,]*, history_frames=[^)]*)" | head -1
grep -a -E "epoch [0-9]+ batch" "$L" | head -2; grep -a -E "epoch [0-9]+ batch" "$L" | tail -2
grep -a "valid:" "$L" | tail -2 | cut -c1-1200
grep -a "valid-cal:" "$L" | tail -1 | cut -c1-1200
grep -a "loss diag" "$L" | tail -4 | cut -c1-400
grep -a -E "Error|Traceback|SIGSEGV|SIGABRT|out of memory|non-finite" "$L" | head -6
NOW=$(ls "$CKPT"/RollingDiTWrapper.0.*.mdlus 2>/dev/null | sed -E 's/.*\.0\.([0-9]+)\.mdlus$/\1/' | sort -n | tail -1)
echo "=== epochs complete: ${NOW:-0} / ${TARGET} ==="
