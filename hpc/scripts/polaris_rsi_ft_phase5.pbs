#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2023 - 2026 NVIDIA CORPORATION & AFFILIATES.
# SPDX-FileCopyrightText: Copyright (c) 2026 The University of Chicago.
# SPDX-FileCopyrightText: All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# RSI drift diagnosis, Phase 5 (2026-09-09): fine-tunes from the batch-40
# BUNDLE production run (checkpoints_prod24_bundle_b40) with the training-side
# anchor remedies switched on, everything else the bundle recipe (lr 5e-4
# linear warmup + cosine to 5e-5 over 24 epochs, Muon momentum 0.85, partial
# activation checkpointing), so a fine-tune from epoch E to E+n is "the same
# run with the augmentation on" and the chain's own epoch E+n is the control.
#
#   FT_CKPT    checkpoint dir, pre-seeded with the base pair
#              RollingDiTWrapper.0.E.mdlus + checkpoint.0.E.pt
#   FT_BASE    base epoch E (sanity check: the dir must hold at least E)
#   FT_TARGET  last epoch to reach
#   FT_SHRINK  loss.anchor_shrink (0 = off)
#   FT_EXCLUDE plus-separated channel indices excluded from the shrink
#   FT_PF      loss.pushforward_rolls K (0 = off): k ~ U{0..K} own-sampler
#              rolls per step, last k anchors self-generated
#   FT_FRESH   loss.fresh_noise_scale used by those rolls (pair with the
#              matching sampler yaml at evaluation)
#   EPOCHS_PER_LINK  epochs per 3 h link (1 for pushforward, 2 otherwise)
#
#PBS -A lighthouse-uchicago
#PBS -q prod
#PBS -l select=10:system=polaris
#PBS -l walltime=02:59:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -j oe
#PBS -N rsi-ft5
set -uo pipefail
R=/eagle/lighthouse-uchicago/members/awikner/physicsnemo-rsi
cd "$R"
source "$R/polaris_env.sh"
export HYDRA_FULL_ERROR=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# The forkserver DataLoader binds an AF_UNIX socket under TMPDIR; on a
# debug-queue node the PBS-provided TMPDIR pushed that path past the 108-byte
# limit (smoke job 7601485). A short node-local temp dir is always safe.
echo "TMPDIR(job)=${TMPDIR:-unset}"
export TMPDIR=/tmp
J=${PBS_JOBID%%.*}
CKPT=${FT_CKPT:?set FT_CKPT}
BASE=${FT_BASE:-20}
TARGET=${FT_TARGET:-22}
SHRINK=${FT_SHRINK:-0.0}
EXCLUDE=${FT_EXCLUDE:-}
PF=${FT_PF:-0}
FRESH=${FT_FRESH:-1.0}
EPOCHS_PER_LINK=${EPOCHS_PER_LINK:-1}
GC_LEVELS=$(cat "$CKPT/grad_checkpoint_levels" 2>/dev/null || echo 14)
PPN=4
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
NRANKS=$((NNODES * PPN))
export GPUS_PER_NODE=$PPN
export MASTER_ADDR=$(head -1 "$PBS_NODEFILE")
export MASTER_PORT=29900
echo "=== $(date) ${NNODES} nodes / ${NRANKS} ranks | ckpt $CKPT | base $BASE target $TARGET | shrink $SHRINK exclude [$EXCLUDE] | pushforward $PF fresh $FRESH | gc_levels $GC_LEVELS ==="
EXPECT_NODES=${FT_NODES:-10}   # FT_NODES=1 for a debug-queue smoke run
[ "$NNODES" -eq "$EXPECT_NODES" ] || { echo "FATAL: expected $EXPECT_NODES nodes, got $NNODES"; exit 1; }
DONE=$(ls "$CKPT"/RollingDiTWrapper.0.*.mdlus 2>/dev/null | sed -E 's/.*\.0\.([0-9]+)\.mdlus$/\1/' | sort -n | tail -1)
DONE=${DONE:-0}
[ "$DONE" -ge "$BASE" ] || { echo "FATAL: $CKPT must be seeded with the epoch-$BASE pair (found epoch ${DONE})"; exit 1; }
if [ "$DONE" -ge "$TARGET" ]; then echo "already at ${DONE}/${TARGET} -- nothing to do"; exit 0; fi
NEPOCH=$((DONE + EPOCHS_PER_LINK)); [ "$NEPOCH" -gt "$TARGET" ] && NEPOCH=$TARGET
echo "=== resume: ${DONE} epochs done -> running through epoch ${NEPOCH} of ${TARGET} ==="
# GPU preflight: a tiny matmul on every rank. Jobs 7601532 and 7601534 both
# died before their first batch with "CUDA error: an illegal instruction was
# encountered" on the same GPU (x3003c0s25b0n0 device 2); a broken device
# otherwise costs the whole 3 h link. On failure the bad hosts are appended to
# $R/bad_nodes_<date>.txt and the job resubmits itself once or twice.
preflight () {
  local out nok
  out=$(timeout 300 mpiexec -n "$NRANKS" --ppn "$PPN" --hostfile "$PBS_NODEFILE" --cpu-bind depth -d 8 \
        bash hpc/scripts/polaris_rank_env.sh \
        python -c 'import os, socket, torch
try:
    x = torch.randn(2048, 2048, device="cuda"); y = (x @ x).sum().item(); torch.cuda.synchronize()
    print("GPUOK", socket.gethostname(), os.environ.get("LOCAL_RANK"))
except Exception as e:
    print("GPUBAD", socket.gethostname(), os.environ.get("LOCAL_RANK"), repr(e)[:160])' 2>&1)
  nok=$(grep -c "^GPUOK" <<< "$out")
  if [ "$nok" -ne "$NRANKS" ]; then
    echo "GPU preflight: only $nok/$NRANKS ranks ok"
    grep -vE "^GPUOK|Warning|warn\(" <<< "$out" | head -12
    grep "^GPUBAD" <<< "$out" | awk '{print $2, "gpu", $3}' | sort -u | tee -a "$R/bad_nodes_$(date +%Y%m%d).txt"
    return 1
  fi
  echo "GPU preflight: all $NRANKS ranks ok"
}
if ! preflight; then
  RETRY=${FT_RETRY:-0}
  if [ "$RETRY" -lt 2 ]; then
    NEW=$(qsub -N "$PBS_JOBNAME" -v "FT_CKPT=$CKPT,FT_BASE=$BASE,FT_TARGET=$TARGET,FT_SHRINK=$SHRINK,FT_EXCLUDE=$EXCLUDE,FT_PF=$PF,FT_FRESH=$FRESH,EPOCHS_PER_LINK=$EPOCHS_PER_LINK,FT_NODES=$EXPECT_NODES,FT_RETRY=$((RETRY + 1))" "$R/polaris_rsi_ft_phase5.pbs" 2>&1)
    echo "bad GPU in the allocation -- resubmitted as $NEW (retry $((RETRY + 1)))"
  fi
  exit 3
fi
EXCL_ARG=()
if [ -n "$EXCLUDE" ]; then EXCL_ARG=("++loss.anchor_shrink_exclude=[${EXCLUDE//+/,}]"); fi
LR=5.0e-4        # bundle recipe (linear scaling), continued cosine schedule
timeout 10200 mpiexec -n "$NRANKS" --ppn "$PPN" --hostfile "$PBS_NODEFILE" \
    --cpu-bind depth -d 8 \
    bash hpc/scripts/polaris_rank_env.sh \
    python examples/weather/ai_rossby/train_diffusion.py \
    --config-dir=examples/weather/ai_rossby/conf --config-name=config \
    run_name=rsi_sstpred_ft5_${CKPT#checkpoints_} \
    model=amip_rsi_sst_pred loss=rsi loss.window_size=6 \
    dataset=amip_dailyavg_coarse_multiyear \
    training=amip_diffusion_bf16 validation=diffusion_rollout seed=0 \
    wandb.enabled=False \
    "++dataset.zarr_path=$AI_ROSSBY_DATA/amip_dailyavg_coarse_train7914" \
    "++dataset.boundary_zarr_path=$AI_ROSSBY_DATA/amip_dailyavg_boundary_train7914" \
    "++dataset.mean_path=$AI_ROSSBY_DATA/amip_dailyavg_coarse/normalize_mean_dailyavg.nc" \
    "++dataset.std_path=$AI_ROSSBY_DATA/amip_dailyavg_coarse/normalize_std_dailyavg.nc" \
    ++dataset.sst_anomaly_channel=none ++dataset.scalar_forcing=none \
    ++dataset.normalize_constant_boundary=true \
    ++dataset.constant_boundary_stats=spatial \
    ++dataset.smooth_constant_lsm=true \
    ++loss.h1_precond=edm \
    "++loss.noise_scale_path=$AI_ROSSBY_DATA/norm_stats/sigma_c_sstpred153.pt" \
    ++loss.gamma_0=1.0 ++loss.gamma_1=0.04 \
    "++loss.anchor_shrink=$SHRINK" "${EXCL_ARG[@]}" \
    "++loss.pushforward_rolls=$PF" "++loss.fresh_noise_scale=$FRESH" \
    ++training.amp=none ++training.matmul_precision=high \
    ++training.grad_checkpoint=true \
    "++training.grad_checkpoint_levels=$GC_LEVELS" \
    "++training.optimizer.lr=$LR" \
    ++training.optimizer.weight_decay=0.01 \
    ++training.optimizer.muon_lr_multiplier=10 \
    ++training.optimizer.muon_momentum=0.85 \
    ++training.ema.decay=0.99 \
    ++training.stages.0.scheduler.type=LinearWarmupCosineAnnealingLR \
    ++training.stages.0.scheduler.num_warmup_epochs=1 \
    ++training.stages.0.scheduler.cosine_total_epochs=24 \
    ++training.stages.0.scheduler.eta_min=5.0e-5 \
    "++training.max_epochs=$NEPOCH" "++training.stages.0.num_epochs=$NEPOCH" \
    ++validation.every_n_epochs=1 \
    "++validation.rollout.climatology.surface_path=$AI_ROSSBY_DATA/norm_stats/val_clim_coarse/climatology_surface.pt" \
    "++validation.rollout.climatology.upper_air_path=$AI_ROSSBY_DATA/norm_stats/val_clim_coarse/climatology_upper_air.pt" \
    "++validation.rollout.climatology.diagnostic_path=$AI_ROSSBY_DATA/norm_stats/val_clim_coarse/climatology_diagnostic.pt" \
    "++checkpoint_dir=$CKPT" \
    > "ft5_${CKPT#checkpoints_}_${J}.log" 2>&1
echo "train exit=$? (124 = hit the timeout) ; === $(date) ==="
L="ft5_${CKPT#checkpoints_}_${J}.log"
grep -am1 "world_size=" "$L"; grep -am1 "steps_per_epoch=" "$L"; grep -am1 "fast-forwarded" "$L"
grep -am1 "drift-diagnosis knobs" "$L"
grep -a -E "epoch [0-9]+ batch" "$L" | head -2; grep -a -E "epoch [0-9]+ batch" "$L" | tail -2
grep -a "valid:" "$L" | tail -4 | cut -c1-400
grep -a -E "Error|Traceback|SIGSEGV|SIGABRT|out of memory|non-finite" "$L" | head -6
NOW=$(ls "$CKPT"/RollingDiTWrapper.0.*.mdlus 2>/dev/null | sed -E 's/.*\.0\.([0-9]+)\.mdlus$/\1/' | sort -n | tail -1)
echo "=== epochs complete: ${NOW:-0} / ${TARGET} ==="
