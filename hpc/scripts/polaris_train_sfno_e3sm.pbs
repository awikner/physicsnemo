#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2023 - 2026 NVIDIA CORPORATION & AFFILIATES.
# SPDX-FileCopyrightText: Copyright (c) 2026 The University of Chicago.
# SPDX-FileCopyrightText: All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# SFNO-E3SM training on ALCF Polaris — 4 nodes x 4 A100 = 16 GPUs,
# 1 sample/GPU => global batch 16.
#
# Two modes, selected with -v MODE=...:
#   test (default) — 60 iterations, no validation, no wandb, per-batch TSV.
#                    Use to prove the launch path and get a s/batch number.
#   full           — long run: EMA, grad clipping, wandb, checkpointing.
#
# Submit:
#   qsub -v MODE=test hpc/scripts/polaris_train_sfno_e3sm.pbs
#   qsub -q preemptable -l walltime=48:00:00 -v MODE=full \
#        hpc/scripts/polaris_train_sfno_e3sm.pbs
#
# QUEUE CHOICE MATTERS. `prod` has a 10-NODE MINIMUM, so it cannot run this
# 4-node job at all. The options for 4 nodes are:
#   debug-scaling  <=10 nodes, <=1 h   -> the `test` mode default below
#   preemptable    <=10 nodes, <=72 h  -> the only queue for a long 4-node run
# preemptable jobs can be killed at any time, so `full` mode keeps
# checkpoint_save_interval low and relies on the recipe's auto-resume.
#
# Required env (pass with -v, or export before qsub):
#   AI_ROSSBY_DATA   physicsnemo-zarr root holding e3sm/
# Optional:
#   MODE             test | full             (default test)
#   MODEL            model config group name (default sfno_e3sm_512)
#   AI_ROSSBY_VENV   venv dir                (default .venv)
#   ITERS            test-mode iteration cap (default 60)
#
# ⚠️ NOT YET RUN END-TO-END ON POLARIS. As of 2026-08-07 there is no
# physicsnemo checkout, venv, or E3SM Zarr on Polaris, and /eagle is 100%
# full. The NCCL env and --cpu-bind flag below ARE measured (hpc/polaris.md);
# the training invocation mirrors the validated Delta one
# (hpc/scripts/bench_sfno_e3sm_512_ddp.sbatch) but has not itself been
# executed here. Expect to shake out venv/data paths on the first `test` run.

#PBS -A lighthouse-uchicago
#PBS -q debug-scaling
#PBS -l select=4:system=polaris
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -N sfno-e3sm-16gpu
#PBS -j oe
#PBS -o sfno_e3sm_polaris.log

set -uo pipefail
cd "${PBS_O_WORKDIR:-$HOME}"

MODE="${MODE:-test}"
MODEL="${MODEL:-sfno_e3sm_512}"
ITERS="${ITERS:-60}"
GPUS_PER_NODE=4
export GPUS_PER_NODE

NODEFILE="${PBS_NODEFILE}"
NNODES=$(wc -l < "${NODEFILE}")
NRANKS=$(( NNODES * GPUS_PER_NODE ))

# ---------------------------------------------------------------- environment
module use /soft/modulefiles
module load conda/2025-09-25
# shellcheck disable=SC1091
conda activate base

# physicsnemo needs torch >= 2.10 (and < 2.11 for working DDP — see
# docs/dev/context/sfno-ddp-requirements.md). The conda module ships 2.8.0, so
# training runs out of a uv venv layered on top (hpc/install.md Option B).
VENV="${AI_ROSSBY_VENV:-.venv}"
if [ ! -f "${VENV}/bin/activate" ]; then
  echo "ERROR: no venv at ${VENV}. Build one per hpc/install.md (Option B):" >&2
  echo "       uv sync --extra cu12 --extra sfno-extras --extra utils-extras \\" >&2
  echo "               --extra datapipes-extras --group dev --python 3.12" >&2
  exit 1
fi
# shellcheck disable=SC1091
source "${VENV}/bin/activate"

# --- NCCL over Slingshot/CXI -------------------------------------------------
# ALCF's documented, tested setup (user-guides nccl.md). Deliberately NOT using
# the conda/*-aws-nccl-* module variants: the -1.9.1 ones point at a plugin
# directory that does not exist and make NCCL die with ncclInvalidUsage. See
# hpc/polaris.md § "Broken conda module variants".
export NCCL_NET_GDR_LEVEL=PHB
export NCCL_CROSS_NIC=1
export NCCL_COLLNET_ENABLE=1
export NCCL_NET="AWS Libfabric"
export LD_LIBRARY_PATH=/soft/libraries/aws-ofi-nccl/v1.9.1-aws/lib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/soft/libraries/hwloc/lib/:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/opt/cray/libfabric/2.2.0rc1/lib64:$LD_LIBRARY_PATH
export FI_CXI_DISABLE_HOST_REGISTER=1
export FI_MR_CACHE_MONITOR=userfaultfd
export FI_CXI_DEFAULT_CQ_SIZE=131072

# makani allocator fix; must be set before CUDA initializes.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

export MASTER_ADDR
MASTER_ADDR=$(head -n1 "${NODEFILE}")
export MASTER_PORT=29500

# --- Data --------------------------------------------------------------------
: "${AI_ROSSBY_DATA:?set AI_ROSSBY_DATA to the physicsnemo-zarr root (must hold e3sm/)}"
export AI_ROSSBY_DATA
ZARR_PATH="${AI_ROSSBY_DATA}/e3sm/2041.zarr"
VAL_ZARR_PATH="${AI_ROSSBY_DATA}/e3sm/2045.zarr"
NORM_ZARR="${AI_ROSSBY_DATA}/e3sm/normalization_2015-2050.zarr"
for d in "${ZARR_PATH}" "${NORM_ZARR}"; do
  [ -d "${d}" ] || { echo "ERROR: ${d} not present." >&2; exit 1; }
done

RUN_NAME="sfno_e3sm_${MODEL}_${NRANKS}gpu_${MODE}_${PBS_JOBID%%.*}"

echo "=================================================================="
echo " SFNO-E3SM on Polaris"
echo "   mode        : ${MODE}"
echo "   model       : ${MODEL}"
echo "   nodes       : ${NNODES}  ranks: ${NRANKS}  (${GPUS_PER_NODE}/node)"
echo "   batch/GPU   : 1          global batch: ${NRANKS}"
echo "   precision   : fp32 (training.amp=none)"
echo "   rendezvous  : ${MASTER_ADDR}:${MASTER_PORT}"
echo "=================================================================="

# --- Mode-specific overrides -------------------------------------------------
if [ "${MODE}" = "test" ]; then
  TSV="${PBS_O_WORKDIR:-$HOME}/${RUN_NAME}.tsv"
  MODE_ARGS=(
    validation=off
    training.max_epochs=1
    training.stages.0.num_epochs=1
    "training.stages.0.max_iterations=${ITERS}"
    training.grad_clip_norm=0.0
    training.ema.enabled=False
    wandb.enabled=False
    wandb.mode=disabled
    "bench.per_batch_tsv=${TSV}"
  )
else
  MODE_ARGS=(
    training.grad_clip_norm=1.0
    training.ema.enabled=True
    # preemptable can kill the job at any moment — checkpoint often.
    checkpoint_save_interval=1
    wandb.enabled=True
    wandb.mode="${WANDB_MODE:-offline}"
    wandb.project="${WANDB_PROJECT:-ai-rossby-e3sm}"
  )
fi

# --- Launch ------------------------------------------------------------------
# `--cpu-bind depth -d 8` IS MANDATORY. Without it aws-ofi-nccl's CPU-side
# progress engine starves and inter-node all-reduce drops 9.1x (4.08 vs
# 36.93 GB/s busbw, measured job 7368993). It fails silently — no error, just
# a slow run. See hpc/polaris.md § "The --cpu-bind trap".
#
# polaris_rank_env.sh maps PALS' PMI_* onto the RANK/WORLD_SIZE/LOCAL_RANK
# that physicsnemo's DistributedManager expects.
mpiexec -n "${NRANKS}" --ppn "${GPUS_PER_NODE}" --hostfile "${NODEFILE}" \
    --cpu-bind depth -d 8 \
    bash hpc/scripts/polaris_rank_env.sh \
    python examples/weather/ai_rossby/train.py \
      --config-dir=examples/weather/ai_rossby/conf \
      --config-name=config \
      "run_name=${RUN_NAME}" \
      "model=${MODEL}" \
      loss=raw_l2 \
      training=sfno_plasim \
      dataset=e3sm \
      seed=0 \
      training.amp=none \
      training.optimizer.fused=True \
      "dataset.zarr_path=${ZARR_PATH}" \
      "dataset.val_zarr_path=${VAL_ZARR_PATH}" \
      "dataset.mean_path=${NORM_ZARR}" \
      "dataset.std_path=${NORM_ZARR}" \
      dataset.batch_size=1 \
      dataset.num_workers=8 \
      "${MODE_ARGS[@]}"
RC=$?

echo
echo "TRAIN_DONE mode=${MODE} nodes=${NNODES} ranks=${NRANKS} exit=${RC}"
if [ "${MODE}" = "test" ] && [ -f "${TSV:-}" ]; then
  echo "per-batch TSV: ${TSV}"
  python hpc/scripts/summarize_bench_tsv.py "${TSV}" --world-size "${NRANKS}" --warmup 10
fi
exit "${RC}"
