#
# Convert the AMIP daily-avg ERA5 archive (H5 -> per-year Zarr) on NCAR
# Derecho (Phase 12c.9). The source lives ONLY on Derecho scratch (which is
# retiring) so conversion runs where the data is; the output lands on
# Derecho scratch and gets replicated per the data registry afterwards.
#
# Also stages the vendored norm stats (tools/data/amip/norm_stats/) next to
# the store root so conf/dataset/amip_dailyavg*.yaml paths resolve.
#
# Submit:  qsub hpc/scripts/convert_amip_dailyavg_derecho.pbs
# 1-year test:
#   qsub -q develop -l walltime=01:00:00 -v YEARS_LO=1981,YEARS_HI=1981 \
#     hpc/scripts/convert_amip_dailyavg_derecho.pbs

#PBS -A UCHI0014
#PBS -q main
#PBS -l select=1:ncpus=128:mpiprocs=1:ompthreads=128
#PBS -l walltime=12:00:00
#PBS -N pn-conv-amipda
#PBS -j oe

set -euo pipefail
REPO=${REPO:-/glade/work/awikner/physicsnemo-amip-v2}
cd "$REPO"
source /glade/work/awikner/physicsnemo/.venv/bin/activate
export PYTHONPATH="$REPO:${PYTHONPATH:-}"

# The per-file H5 reader sizes its pool from SLURM_CPUS_PER_TASK; on PBS give
# it the whole node.
export SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-${OMP_NUM_THREADS:-128}}

YEARS_LO=${YEARS_LO:-1978}
YEARS_HI=${YEARS_HI:-2024}
H5_DIR=${H5_DIR:-/glade/derecho/scratch/awikner/ERA5/h5_dailyavg}
OUT_ROOT=${OUT_ROOT:-/glade/derecho/scratch/awikner/physicsnemo-zarr/amip_dailyavg}
mkdir -p "$OUT_ROOT"

# Stage the vendored norm stats next to the store root (idempotent).
cp -n tools/data/amip/norm_stats/normalize_mean_dailyavg.nc "$OUT_ROOT/" || true
cp -n tools/data/amip/norm_stats/normalize_std_dailyavg.nc "$OUT_ROOT/" || true

echo "[$(date)] amip_dailyavg conversion ${YEARS_LO}-${YEARS_HI} on $(hostname), $(nproc) cores"
n_ok=0; n_skip=0; n_fail=0
for YEAR in $(seq "$YEARS_LO" "$YEARS_HI"); do
    OUT_PATH="$OUT_ROOT/${YEAR}.zarr"
    if [ -d "$OUT_PATH" ]; then
        echo "[$(date)] skip $YEAR (exists)"; n_skip=$((n_skip+1)); continue
    fi
    echo "[$(date)] converting amip_dailyavg year $YEAR ..."
    # Write to a .partial dir and atomic-rename on success — a walltime
    # kill mid-year must not leave a store the skip-if-exists check
    # mistakes for complete (bit job 7045083).
    OUT_TMP="$OUT_ROOT/${YEAR}.zarr.partial"
    rm -rf "$OUT_TMP"
    if python tools/data/amip/amip_h5_to_zarr.py \
            --config tools/data/amip/configs/amip_dailyavg.yaml \
            --config-key AMIP \
            --input-dir "$H5_DIR" \
            --year "$YEAR" \
            --output "$OUT_TMP" \
            --time-chunk 1; then
        mv "$OUT_TMP" "$OUT_PATH"
        n_ok=$((n_ok+1))
    else
        echo "[$(date)] YEAR $YEAR FAILED"; n_fail=$((n_fail+1)); rm -rf "$OUT_TMP"
    fi
done
echo "[$(date)] done: ok=$n_ok skip=$n_skip fail=$n_fail"
[ "$n_fail" -eq 0 ]