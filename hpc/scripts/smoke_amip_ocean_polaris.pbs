#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2023 - 2026 NVIDIA CORPORATION & AFFILIATES.
# SPDX-FileCopyrightText: Copyright (c) 2026 The University of Chicago.
# SPDX-License-Identifier: Apache-2.0
#
# Phase 12f GPU smoke — predicted ocean channels + partial-checkpoint warm
# start, on the real daily-avg data. Three steps in one job:
#
#   1. no-ocean baseline mini-stage (model=amip_erdm_v2) that SAVES a
#      checkpoint — the warm-start source.
#   2. ocean-variant mini-stage (model=amip_erdm_v2_ocean) warm-started from
#      step 1 via training.partial_checkpoint. Asserts the log reports
#      **zero skipped keys** (ocean support only adds parameters) and that
#      train/loss_ocean is reported alongside train/loss.
#   3. same ocean run from scratch under 2-rank DDP, so the DistributedSampler
#      path over the shifted (forcing_lag=1) SequenceDataset is exercised too.
#
# Runs on Polaris because that is where the data is: amip_dailyavg_coarse
# (45x90 state) + amip_dailyavg_boundary (1 degree forcings) are staged under
# /eagle/lighthouse-uchicago. Delta holds neither — see hpc/data_registry.yaml.
#
# The backbone is shrunk (dim 128 / 2 blocks) so this is a wiring test, not a
# throughput test; 12c benched the I/O and 12e the full 561.6M parameter tree.
# ``input_embed`` budgets are overridden along with dim because the budget has
# floors: d_state >= 24 for the column encoder and d_co2 < d_calendar.
#
# Submit:  qsub hpc/scripts/smoke_amip_ocean_polaris.pbs

#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l walltime=00:50:00
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -N pn-smoke-amip-ocean

set -euo pipefail

REPO=/eagle/lighthouse-uchicago/members/awikner/physicsnemo
export AI_ROSSBY_DATA=/eagle/lighthouse-uchicago/physicsnemo-zarr
cd "$REPO"

LOGDIR="$REPO/hpc/scripts/logs"
mkdir -p "$LOGDIR"
JOB=${PBS_JOBID:-local}

# resolve() on both sides: /eagle is a symlink to /lus/eagle/projects, so a
# plain prefix match on $REPO fails even when the import is correct.
.venv/bin/python -c "import physicsnemo, pathlib; p = pathlib.Path(physicsnemo.__file__).resolve(); \
root = pathlib.Path('$REPO').resolve(); \
assert root in p.parents, f'wrong physicsnemo on path: {p} (want under {root})'; \
print('physicsnemo from', p)"

for store in amip_dailyavg_coarse/1981.zarr amip_dailyavg_boundary/1981.zarr; do
    [[ -d "$AI_ROSSBY_DATA/$store" ]] || { echo "ERROR: missing $AI_ROSSBY_DATA/$store"; exit 1; }
done

cd examples/weather/ai_rossby
PY="$REPO/.venv/bin/python"
TORCHRUN="$REPO/.venv/bin/torchrun"

# Shared overrides: the shrunk backbone + a capped rolling stage.
COMMON=(
    loss=erdm_v2
    loss.window_size=6
    dataset=amip_dailyavg_coarse
    training=amip_diffusion_bf16
    validation=off
    training.max_epochs=1
    training.ema.warmup_epochs=0
    'training.stages.0.max_iterations=12'
    'model.rolling_dit_kwargs.dim=128'
    'model.rolling_dit_kwargs.num_blocks=2'
    'model.rolling_dit_kwargs.num_heads=4'
    'model.rolling_dit_kwargs.temporal_num_heads=4'
    'model.rolling_dit_kwargs.c_grid_cross_layers=1'
    'model.rolling_dit_kwargs.c_grid_cross_heads=4'
    'model.rolling_dit_kwargs.input_embed.d_boundary=32'
    'model.rolling_dit_kwargs.input_embed.d_calendar=32'
    'model.rolling_dit_kwargs.input_embed.d_co2=8'
    dataset.batch_size=1
    dataset.num_workers=4
    log_every_n_steps=2
)

BASE_CKPT="./checkpoints_ocean_smoke_${JOB}_base"
OCEAN_CKPT="./checkpoints_ocean_smoke_${JOB}_ocean"
DDP_CKPT="./checkpoints_ocean_smoke_${JOB}_ddp"
STEP1_LOG="$LOGDIR/amip-ocean-smoke-$JOB-step1.log"
STEP2_LOG="$LOGDIR/amip-ocean-smoke-$JOB-step2.log"

echo "=== Step 1/3: no-ocean baseline (warm-start source) ==="
"$PY" train_diffusion.py \
    model=amip_erdm_v2 \
    "${COMMON[@]}" \
    run_name="amip-ocean-smoke-base-$JOB" \
    +checkpoint_dir="$BASE_CKPT" 2>&1 | tee "$STEP1_LOG"

SRC=$(ls -1 "$BASE_CKPT"/*.mdlus 2>/dev/null | head -1 || true)
[[ -n "$SRC" ]] || { echo "ERROR: step 1 saved no .mdlus under $BASE_CKPT"; exit 1; }
echo "warm-start source: $SRC"

echo
echo "=== Step 2/3: ocean variant, warm-started (expect ZERO skipped keys) ==="
"$PY" train_diffusion.py \
    model=amip_erdm_v2_ocean \
    "${COMMON[@]}" \
    "training.partial_checkpoint=$SRC" \
    run_name="amip-ocean-smoke-warm-$JOB" \
    +checkpoint_dir="$OCEAN_CKPT" 2>&1 | tee "$STEP2_LOG"

# The whole point of the warm start is the report, so check it rather than
# trusting that the run merely didn't crash.
if grep -q "SKIPPED" "$STEP2_LOG"; then
    echo "FAIL: partial checkpoint skipped keys — see $STEP2_LOG"
    grep -A 20 "SKIPPED" "$STEP2_LOG"
    exit 1
fi
grep -q "partial checkpoint .*loaded" "$STEP2_LOG" || {
    echo "FAIL: no partial-checkpoint report in $STEP2_LOG"; exit 1; }
grep -q "ocean contract: nocean=2, c_grid indices=\[1, 2\]" "$STEP2_LOG" || {
    echo "FAIL: scheduler did not adopt the ocean contract"; exit 1; }
grep -q "loss_ocean=" "$STEP2_LOG" || {
    echo "FAIL: train/loss_ocean was never reported"; exit 1; }
echo "warm start OK: zero skipped keys, ocean contract adopted, loss_ocean logged"
grep "loss_ocean=" "$STEP2_LOG" | tail -3

echo
echo "=== Step 3/3: ocean variant from scratch, 2-rank DDP ==="
# Covers the DistributedSampler over the shifted SequenceDataset. wandb is
# left default-on (every-rank, offline) — the rank-0-only init that hung DDP
# was fixed in the W1-W4 work; see docs/dev/wandb_ddp_hang_fix_plan.md.
"$TORCHRUN" --standalone --nproc-per-node=2 train_diffusion.py \
    model=amip_erdm_v2_ocean \
    "${COMMON[@]}" \
    run_name="amip-ocean-smoke-ddp-$JOB" \
    +checkpoint_dir="$DDP_CKPT"

echo
echo "=== Phase 12f ocean smoke passed for job $JOB ==="
