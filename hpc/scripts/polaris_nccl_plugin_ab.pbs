#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2023 - 2026 NVIDIA CORPORATION & AFFILIATES.
# SPDX-FileCopyrightText: Copyright (c) 2026 The University of Chicago.
# SPDX-FileCopyrightText: All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# Clean, controlled isolation of the aws-ofi-nccl PLUGIN BUILD as the cause of
# Polaris' 2-node all-reduce collapse.
#
# Why a re-run. Job 7368976 tried to A/B this but its control was invalid: the
# "module-1.6.0" variant unset the NCCL/FI vars without stripping
# v1.9.1-aws from LD_LIBRARY_PATH, and since that path was PREPENDED the
# control silently kept using the good plugin. All three variants therefore
# measured the same plugin (~37-39 GB/s) and the 8.5x claim rested on a
# cross-job comparison against 7368955 rather than a within-job control.
#
# This script fixes that: identical conda base, identical NCCL_*/FI_* env,
# LD_LIBRARY_PATH rebuilt from a saved pristine BASE_LD for every variant, and
# ONLY the plugin directory changes between them.
#
# Plugin builds present on Polaris (all compiled against libfabric 1.22.0,
# which is NO LONGER INSTALLED — the system now ships only 2.2.0rc1):
#   v1.9.1-aws                  <- what ALCF's own docs recommend
#   v1.6.0-libfabric-1.22.0     <- what conda/*-aws-nccl-1.6.0 loads
#   v1.9.1-aws-libfabric-1.22.0 <- what I hand-patched to in job 7368936
#                                  (SIGSEGV at 1 node; expected to misbehave)
#
# RESULT — the plugin is NOT the cause. Measured @ 4.404 GiB, 2 nodes:
#   v1.9.1-aws                   223.77 ms -> 36.98 GB/s
#   v1.9.1-aws-libfabric-1.22.0  223.88 ms -> 36.96 GB/s
#   v1.6.0-libfabric-1.22.0      produced no benchmark output (failed)
# Two different builds land within 0.06% of each other, so the build cannot
# explain job 7368955's 4.58 GB/s.
#
# The actual cause, found in job 7368993: a missing `--cpu-bind` on mpiexec
# (4.08 GB/s unbound vs 36.93 GB/s with `depth -d 8`). Note THIS script passes
# `--cpu-bind depth -d 8`, which is why all its variants looked fast.
# See hpc/polaris.md.
#
# Lesson for future probes: the per-variant filter here grepped only for
# success patterns, so when v1.6.0 failed the log captured NOTHING and the
# failure mode was unrecoverable. polaris_nccl_cause_ab.pbs captures the exit
# code and last 25 lines unconditionally instead.
#
# Submit:
#   qsub hpc/scripts/polaris_nccl_plugin_ab.pbs

#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l walltime=00:40:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -N polaris-plugin-ab
#PBS -j oe
#PBS -o polaris_nccl_plugin_ab.log

set -uo pipefail
cd "${PBS_O_WORKDIR:-$HOME}"

NODEFILE="${PBS_NODEFILE}"
NNODES=$(wc -l < "${NODEFILE}")
PPN=4
export PPN
export MASTER_ADDR
MASTER_ADDR=$(head -n1 "${NODEFILE}")

echo "=== Polaris aws-ofi-nccl PLUGIN isolation : ${NNODES} nodes, $(( NNODES * PPN )) ranks ==="

# Plain conda module — verified to export NO NCCL_* or FI_* variables, so it is
# a clean base we can layer a single, identical env on top of.
module use /soft/modulefiles
module load conda/2025-09-25
# shellcheck disable=SC1091
conda activate base

# Pristine LD_LIBRARY_PATH captured BEFORE any plugin dir is added. Every
# variant rebuilds from this, so plugin paths can never accumulate — that
# accumulation is exactly what invalidated job 7368976's control.
BASE_LD="${LD_LIBRARY_PATH:-}"

# ALCF's documented NCCL env (user-guides nccl.md), held CONSTANT across
# variants. Only the plugin directory below varies.
export NCCL_NET_GDR_LEVEL=PHB
export NCCL_CROSS_NIC=1
export NCCL_COLLNET_ENABLE=1
export NCCL_NET="AWS Libfabric"
export FI_CXI_DISABLE_HOST_REGISTER=1
export FI_MR_CACHE_MONITOR=userfaultfd
export FI_CXI_DEFAULT_CQ_SIZE=131072

run_plugin () {
  local tag=$1 plugin=$2 port=$3
  export MASTER_PORT=$port
  echo
  echo "########## PLUGIN: ${tag} ##########"
  echo "  dir: ${plugin}"
  if [ ! -f "${plugin}/lib/libnccl-net.so" ]; then
    echo "  SKIP — no libnccl-net.so at ${plugin}/lib"
    echo "########## END ${tag} ##########"
    return
  fi
  # Rebuild from pristine base every time.
  export LD_LIBRARY_PATH="${plugin}/lib:/soft/libraries/hwloc/lib:/opt/cray/libfabric/2.2.0rc1/lib64:${BASE_LD}"
  mpiexec -n "$(( NNODES * PPN ))" --ppn "${PPN}" --hostfile "${NODEFILE}" \
      --cpu-bind depth -d 8 \
      python hpc/scripts/allreduce_probe.py 2>&1 \
    | grep -E "^\[nodes=|Selected Provider|Using network|signal 11|Failed to initialize|ncclInvalidUsage" \
    | head -12
  echo "########## END ${tag} ##########"
}

P=/soft/libraries/aws-ofi-nccl
run_plugin "v1.9.1-aws__ALCF-DOCS"      "${P}/v1.9.1-aws"                  29801
run_plugin "v1.6.0-libfabric-1.22.0"    "${P}/v1.6.0-libfabric-1.22.0"     29802
run_plugin "v1.9.1-aws-libfabric-1.22.0" "${P}/v1.9.1-aws-libfabric-1.22.0" 29803

echo
echo "PLUGIN_AB_DONE nodes=${NNODES}"
