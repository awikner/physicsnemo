# SPDX-License-Identifier: Apache-2.0
#
# Find the ACTUAL cause of Polaris' 2-node all-reduce collapse by changing one
# variable at a time from a known-fast baseline.
#
# History of wrong guesses (each disproved by measurement, kept so nobody
# re-litigates them):
#   1. "The extra FI_CXI knobs (RX_MATCH_MODE=software, RDZV_THRESHOLD=2000)."
#      Disproved: job 7368976 "docs+xfi" carried all of them -> 38.79 GB/s.
#   2. "The aws-ofi-nccl plugin build (v1.6.0-libfabric-1.22.0 vs v1.9.1-aws)."
#      Disproved: job 7368980 ran v1.6.0-libfabric-1.22.0 under the clean env
#      -> 36.98 GB/s, i.e. the SAME plugin that measured 4.58 GB/s in 7368955.
#
# What still differs between the slow run (7368955, 4.58 GB/s) and the fast
# runs (~37-39 GB/s):
#   (a) mpiexec had NO --cpu-bind in 7368955; the fast runs use
#       `--cpu-bind depth -d 8`. ALCF's PyTorch page explicitly calls CPU
#       affinity out as a scaling factor, and aws-ofi-nccl drives its progress
#       engine on the CPU — bad affinity can plausibly starve it.
#   (b) NCCL_SOCKET_IFNAME=hsn was set by the conda module, unset in the fast runs.
#   (c) 7368955 loaded conda/2025-09-25-aws-nccl-1.6.0; fast runs loaded plain
#       conda/2025-09-25 and layered ALCF's documented env on top.
#
# Variants below change exactly one of those at a time from the fast baseline,
# plus a full reproduction of the slow configuration as a positive control.
#
# ============================ RESULT (job 7368993) ==========================
# 2 nodes, 8 ranks, all-reduce of the 4.404 GiB SFNO-E3SM embed_dim=512 gradient:
#
#   A_baseline_cpubind8            224.06 ms -> 36.93 GB/s
#   B_nocpubind                   2027.33 ms ->  4.08 GB/s   <-- 9.1x SLOWER
#   C_cpubind16                    223.86 ms -> 36.96 GB/s
#   D_socket_ifname_hsn            224.24 ms -> 36.90 GB/s
#   E_slow_repro_module_nocpubind 2086.72 ms ->  3.97 GB/s   <-- reproduces 7368955
#
# CAUSE: a missing `--cpu-bind` on PALS mpiexec. Nothing else mattered — the
# plugin build, the seven extra FI_CXI knobs and NCCL_SOCKET_IFNAME are all
# within noise. `depth -d 8` and `-d 16` are equivalent.
#
# Mechanism: aws-ofi-nccl runs its libfabric/CXI progress engine on the CPU.
# Under PALS' default placement the 4 ranks are not spread over the node's 4
# NUMA domains, so those progress threads starve. Delta never showed this
# because srun with --cpus-per-task binds by default.
#
# Diagnostic signature: unbound, busbw FALLS with message size (12.2 -> 4.6
# GB/s); bound, it rises to a plateau.
# ============================================================================
#
# Submit:
#   qsub hpc/scripts/polaris_nccl_cause_ab.pbs

#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l walltime=00:50:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -N polaris-cause-ab
#PBS -j oe
#PBS -o polaris_nccl_cause_ab.log

set -uo pipefail
cd "${PBS_O_WORKDIR:-$HOME}"

NODEFILE="${PBS_NODEFILE}"
NNODES=$(wc -l < "${NODEFILE}")
PPN=4
export PPN
export MASTER_ADDR
MASTER_ADDR=$(head -n1 "${NODEFILE}")
PLUGIN=/soft/libraries/aws-ofi-nccl/v1.9.1-aws

echo "=== Polaris cause isolation : ${NNODES} nodes, $(( NNODES * PPN )) ranks ==="

module use /soft/modulefiles
module load conda/2025-09-25
# shellcheck disable=SC1091
conda activate base
BASE_LD="${LD_LIBRARY_PATH:-}"

apply_docs_env () {
  export NCCL_NET_GDR_LEVEL=PHB
  export NCCL_CROSS_NIC=1
  export NCCL_COLLNET_ENABLE=1
  export NCCL_NET="AWS Libfabric"
  export FI_CXI_DISABLE_HOST_REGISTER=1
  export FI_MR_CACHE_MONITOR=userfaultfd
  export FI_CXI_DEFAULT_CQ_SIZE=131072
  export LD_LIBRARY_PATH="${PLUGIN}/lib:/soft/libraries/hwloc/lib:/opt/cray/libfabric/2.2.0rc1/lib64:${BASE_LD}"
  unset NCCL_SOCKET_IFNAME
}

# $1 = tag, $2 = port, $3.. = extra mpiexec args (e.g. --cpu-bind depth -d 8)
run_case () {
  local tag=$1 port=$2; shift 2
  export MASTER_PORT=$port
  echo
  echo "########## CASE: ${tag} ##########"
  echo "  mpiexec extra args : $*"
  echo "  NCCL_SOCKET_IFNAME : ${NCCL_SOCKET_IFNAME:-unset}"
  echo "  plugin             : $(echo "$LD_LIBRARY_PATH" | tr ':' '\n' | grep aws-ofi-nccl | head -1)"
  # Capture the LAST 25 lines unconditionally rather than grepping for success
  # patterns only. In job 7368980 the filter was `grep '^\[nodes=|signal 11|...'`
  # and the v1.6.0 variant failed in some way none of those matched — so the
  # log recorded nothing at all and the failure mode was unrecoverable.
  local out="/tmp/case_${tag}.$$"
  mpiexec -n "$(( NNODES * PPN ))" --ppn "${PPN}" --hostfile "${NODEFILE}" "$@" \
      python hpc/scripts/allreduce_probe.py > "$out" 2>&1
  local rc=$?
  echo "  exit=${rc}"
  if grep -q "^\[nodes=" "$out"; then
    grep -E "^\[nodes=" "$out" | tail -6
  else
    echo "  !! no benchmark output — last 25 lines:"
    tail -25 "$out" | sed 's/^/  | /'
  fi
  rm -f "$out"
  echo "########## END ${tag} ##########"
}

# --- Baseline: known-fast configuration --------------------------------------
apply_docs_env
run_case "A_baseline_cpubind8"      29901 --cpu-bind depth -d 8

# --- (a) drop CPU binding, everything else identical -------------------------
apply_docs_env
run_case "B_nocpubind"              29902

# --- (a') deeper binding, per ALCF's -d 16 suggestion ------------------------
apply_docs_env
run_case "C_cpubind16"              29903 --cpu-bind depth -d 16

# --- (b) add back NCCL_SOCKET_IFNAME=hsn, keep good binding ------------------
apply_docs_env
export NCCL_SOCKET_IFNAME=hsn
run_case "D_socket_ifname_hsn"      29904 --cpu-bind depth -d 8

# --- (c) positive control: reproduce the SLOW config exactly -----------------
# conda/*-aws-nccl-1.6.0 as shipped, no cpu-bind — i.e. job 7368955.
unset NCCL_NET NCCL_NET_GDR_LEVEL NCCL_CROSS_NIC NCCL_COLLNET_ENABLE \
      NCCL_SOCKET_IFNAME FI_CXI_DISABLE_HOST_REGISTER FI_MR_CACHE_MONITOR \
      FI_CXI_DEFAULT_CQ_SIZE
export LD_LIBRARY_PATH="${BASE_LD}"
module unload conda/2025-09-25 2>/dev/null
module load conda/2025-09-25-aws-nccl-1.6.0
# shellcheck disable=SC1091
conda activate base
run_case "E_slow_repro_module_nocpubind" 29905

echo
echo "CAUSE_AB_DONE nodes=${NNODES}"
