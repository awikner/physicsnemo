#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2023 - 2026 NVIDIA CORPORATION & AFFILIATES.
# SPDX-FileCopyrightText: Copyright (c) 2026 The University of Chicago.
# SPDX-FileCopyrightText: All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# Polaris node + interconnect inventory, and a measured NCCL all-reduce
# bandwidth curve at the SFNO-E3SM embed_dim=512 gradient size (4.40 GiB).
#
# Motivation: on Delta the SAME model at 2 nodes ran 3.5051 s/batch with stock
# NCCL (TCP-socket fallback over Slingshot) vs 0.7846 s/batch once
# aws-ofi-nccl/libfabric-cxi was loaded — a 4.5x swing driven purely by NCCL's
# choice of transport. Polaris is also a Slingshot/CXI machine, so before
# estimating how this code scales there we measure the fabric directly rather
# than trusting a spec sheet.
#
# Submit:
#   qsub hpc/scripts/polaris_topo_probe.pbs

#PBS -A lighthouse-uchicago
#PBS -q debug-scaling
#PBS -l select=4:system=polaris
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -N polaris-topo-probe
#PBS -j oe
#PBS -o polaris_topo_probe_v3.log

set -uo pipefail
cd "${PBS_O_WORKDIR:-$HOME}"

NODEFILE="${PBS_NODEFILE}"
NNODES=$(wc -l < "${NODEFILE}")
PPN=4
export PPN

echo "=================================================================="
echo " Polaris node + interconnect probe"
echo "   job     : ${PBS_JOBID}"
echo "   nodes   : ${NNODES}"
echo "=================================================================="
echo "--- nodefile ---"
cat "${NODEFILE}"

# ---------------------------------------------------------------- inventory
echo
echo "########## PER-NODE INVENTORY ##########"
mpiexec -n "${NNODES}" --ppn 1 --hostfile "${NODEFILE}" bash -c '
echo "===== $(hostname) ====="
echo "--- GPUs ---"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
echo "--- GPU/NIC topology (NVLink + HSN affinity) ---"
nvidia-smi topo -m 2>/dev/null
echo "--- CPU ---"
lscpu | grep -E "^Model name|^CPU\(s\)|^Thread|^Core|^Socket|^NUMA node\(s\)"
echo "--- Slingshot CXI NICs ---"
ls /sys/class/cxi 2>/dev/null || echo "(no /sys/class/cxi)"
fi_info -p cxi 2>/dev/null | grep -E "^\s*domain:" | sort -u
echo "--- HSN interfaces ---"
ip -o -4 addr show 2>/dev/null | awk "{print \$2, \$4}" | grep -v "^lo"
'

# ------------------------------------------------------ allreduce bandwidth
# ALCF ships conda envs with the AWS OFI NCCL plugin already wired in — the
# `-aws-nccl` suffix. Using one means NCCL takes libfabric/cxi rather than
# falling back to TCP, which is the whole ballgame for multi-node (see header).
module use /soft/modulefiles
# SUPERSEDED — this script's 2-node numbers (4.58 GB/s, job 7368955) are a
# MEASUREMENT ARTIFACT of this script, not a property of Polaris. The mpiexec
# call below has no --cpu-bind, and job 7368993 later showed that omitting it
# costs 9.1x on inter-node all-reduce (4.08 vs 36.93 GB/s). Correctly bound,
# Polaris does ~37 GB/s at 2 nodes. See hpc/polaris.md.
#
# Two hypotheses this script's header used to blame were both disproved:
#   - the aws-ofi-nccl plugin build  -> job 7368980, all builds ~37 GB/s
#   - the extra FI_CXI_* knobs       -> job 7368976, within noise
# The module audit below is still factually correct and worth keeping, but it
# is NOT the cause of the slow numbers.
#
# Module audit (2026-08-07) — which conda/*-aws-nccl-* variants point at a
# plugin directory that actually exists on disk:
#   2025-09-25-aws-nccl-1.6.0  -> v1.6.0-libfabric-1.22.0        [EXISTS]
#   2025-09-25-aws-nccl-1.9.1  -> v1.9.1-libfabric-1.22.0        [MISSING]
#   2025-09-26-aws-nccl-1.9.1  -> v1.9.1-libfabric-1.22.0        [MISSING]
#
# For new work prefer plain conda/2025-09-25 + ALCF's documented NCCL env +
# `--cpu-bind depth -d 8`, as in hpc/scripts/polaris_nccl_cause_ab.pbs.
module load conda/2025-09-25-aws-nccl-1.6.0
# shellcheck disable=SC1091
conda activate base
echo "AWS_DIR=${AWS_DIR:-unset}"
ls -1 "${AWS_DIR}/lib/" 2>/dev/null | head -4

echo
echo "########## NCCL ALL-REDUCE BANDWIDTH ##########"
python -c "import torch; print('torch', torch.__version__, 'nccl', torch.cuda.nccl.version())"

export MASTER_ADDR
MASTER_ADDR=$(head -n1 "${NODEFILE}")
export MASTER_PORT=29511
# INIT subsys prints the "Using network AWS Libfabric" / NIC-count lines that
# prove the plugin actually took, without the per-collective firehose.
export NCCL_DEBUG="${NCCL_DEBUG:-INFO}"
export NCCL_DEBUG_SUBSYS="${NCCL_DEBUG_SUBSYS:-INIT}"

for N in 1 2 4; do
  [ "${N}" -gt "${NNODES}" ] && continue
  head -n "${N}" "${NODEFILE}" > "/tmp/hosts_${N}"
  # Re-home the rendezvous on this subset's first node.
  MASTER_ADDR=$(head -n1 "/tmp/hosts_${N}")
  export MASTER_ADDR
  export MASTER_PORT=$(( 29511 + N ))
  echo
  echo "---------- ${N} node(s), $(( N * PPN )) ranks ----------"
  mpiexec -n "$(( N * PPN ))" --ppn "${PPN}" --hostfile "/tmp/hosts_${N}" \
      python hpc/scripts/allreduce_probe.py
done

echo
echo "PROBE_DONE nodes=${NNODES}"
