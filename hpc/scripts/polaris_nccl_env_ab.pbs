# SPDX-License-Identifier: Apache-2.0
#
# A/B the ALCF-documented NCCL environment against what the conda modules
# actually set, at 2 nodes, using the same all-reduce probe as everything else.
#
# ⚠️ THIS SCRIPT'S CONTROL IS INVALID — kept for provenance only.
# The "module-1.6.0" variant unsets the NCCL/FI vars but never strips
# v1.9.1-aws from LD_LIBRARY_PATH; because that path was PREPENDED, the control
# silently kept using the good plugin. All three variants therefore measured
# the same plugin (37.07 / 38.79 / 38.67 GB/s) and the run proves nothing about
# the module.
#
# What it DID legitimately establish: variants 1 vs 2 differ only in the seven
# extra FI_CXI_* knobs, and they are within noise (37.07 vs 38.79 GB/s). So
# those knobs are not the cause.
#
# The real cause was found later in job 7368993: a missing `--cpu-bind` on
# mpiexec, worth 9.1x. See hpc/polaris.md and polaris_nccl_cause_ab.pbs.
# Note this script already passes `--cpu-bind depth -d 8`, which is why every
# variant here looked fast.
#
# Background. Measured 2-node all-reduce of the 4.404 GiB SFNO-E3SM gradient:
#     Delta   (1 Slingshot NIC) : 478.8 ms -> 17.28 GB/s busbw   [healthy]
#     Polaris (2 Slingshot NICs): 1806.3 ms ->  4.58 GB/s busbw  [broken]
# Polaris' curve FALLS with message size (12.21 -> 4.58 GB/s), which is a
# large-message-path problem, not a link-speed problem.
#
# ALCF's own docs (user-guides: docs/polaris/applications-and-libraries/
# libraries/nccl.md) publish a tested "best environment setup" that differs
# from what `conda/2025-09-25-aws-nccl-1.6.0` exports, in two ways:
#
#  (a) PLUGIN PATH. Docs say /soft/libraries/aws-ofi-nccl/v1.9.1-aws/lib
#      (exists, rebuilt 2025-09-03). The 1.6.0 module uses
#      v1.6.0-libfabric-1.22.0, and the 1.9.1 module points at
#      v1.9.1-libfabric-1.22.0 which does not exist at all. Every
#      *-libfabric-1.22.0 build was compiled against libfabric 1.22.0, and
#      Polaris now ships only 2.2.0rc1.
#
#  (b) EXTRA FI_CXI KNOBS. The module additionally sets
#      FI_CXI_RX_MATCH_MODE=software, FI_CXI_RDZV_THRESHOLD=2000,
#      FI_CXI_RDZV_PROTO=alt_read, FI_CXI_RDZV_GET_MIN=0,
#      FI_CXI_REQ_BUF_SIZE=16MB, FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD=16000,
#      FI_CXI_DEFAULT_TX_SIZE=131072 — NONE of which appear in ALCF's tuned
#      recipe. Software rx-matching and a 2 KB rendezvous threshold are both
#      plausible causes of a large-message collapse.
#
# Three variants isolate (a) from (b):
#   docs      : docs plugin + docs FI vars only            <- ALCF recipe
#   docs+xfi  : docs plugin + the module's extra FI knobs  <- blames (b) if slow
#   module    : conda/*-aws-nccl-1.6.0 as-is               <- control, expect ~4.58
#
# Submit:
#   qsub hpc/scripts/polaris_nccl_env_ab.pbs

#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l walltime=00:40:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -N polaris-nccl-ab
#PBS -j oe
#PBS -o polaris_nccl_env_ab.log

set -uo pipefail
cd "${PBS_O_WORKDIR:-$HOME}"

NODEFILE="${PBS_NODEFILE}"
NNODES=$(wc -l < "${NODEFILE}")
PPN=4
export PPN
export MASTER_ADDR
MASTER_ADDR=$(head -n1 "${NODEFILE}")

echo "=== Polaris NCCL env A/B : ${NNODES} nodes, $(( NNODES * PPN )) ranks ==="

module use /soft/modulefiles

# The extra FI_CXI knobs the conda modules add on top of ALCF's documented set.
EXTRA_FI=(FI_CXI_DEFAULT_TX_SIZE FI_CXI_RDZV_PROTO FI_CXI_RX_MATCH_MODE
          FI_CXI_REQ_BUF_SIZE FI_CXI_RDZV_GET_MIN
          FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD FI_CXI_RDZV_THRESHOLD)

apply_docs_env () {
  # Verbatim from ALCF user-guides nccl.md "best environment setup".
  export NCCL_NET_GDR_LEVEL=PHB
  export NCCL_CROSS_NIC=1
  export NCCL_COLLNET_ENABLE=1
  export NCCL_NET="AWS Libfabric"
  export LD_LIBRARY_PATH=/soft/libraries/aws-ofi-nccl/v1.9.1-aws/lib:$LD_LIBRARY_PATH
  export LD_LIBRARY_PATH=/soft/libraries/hwloc/lib/:$LD_LIBRARY_PATH
  export FI_CXI_DISABLE_HOST_REGISTER=1
  export FI_MR_CACHE_MONITOR=userfaultfd
  export FI_CXI_DEFAULT_CQ_SIZE=131072
  # libfabric itself still has to be findable.
  export LD_LIBRARY_PATH=/opt/cray/libfabric/2.2.0rc1/lib64:$LD_LIBRARY_PATH
}

apply_extra_fi () {
  export FI_CXI_DEFAULT_TX_SIZE=131072
  export FI_CXI_RDZV_PROTO=alt_read
  export FI_CXI_RX_MATCH_MODE=software
  export FI_CXI_REQ_BUF_SIZE=16MB
  export FI_CXI_RDZV_GET_MIN=0
  export FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD=16000
  export FI_CXI_RDZV_THRESHOLD=2000
}

run_variant () {
  local tag=$1 port=$2
  export MASTER_PORT=$port
  echo
  echo "########## VARIANT: ${tag} ##########"
  echo "  plugin dir : $(echo "$LD_LIBRARY_PATH" | tr ':' '\n' | grep aws-ofi-nccl | head -1)"
  echo "  NCCL_NET   : ${NCCL_NET:-unset}"
  for v in "${EXTRA_FI[@]}"; do
    [ -n "${!v:-}" ] && echo "  ${v}=${!v}"
  done
  mpiexec -n "$(( NNODES * PPN ))" --ppn "${PPN}" --hostfile "${NODEFILE}" \
      --cpu-bind depth -d 8 \
      python hpc/scripts/allreduce_probe.py 2>&1 \
    | grep -E "^\[nodes=|Selected Provider|Using network|Error|Traceback" | head -20
  echo "########## END ${tag} ##########"
}

# ---- Variant 1: ALCF documented recipe on a clean (no-NCCL-env) conda -------
module load conda/2025-09-25
# shellcheck disable=SC1091
conda activate base
for v in "${EXTRA_FI[@]}"; do unset "$v"; done
apply_docs_env
run_variant "docs" 29701

# ---- Variant 2: docs plugin + the module's extra FI knobs -------------------
apply_extra_fi
run_variant "docs+xfi" 29702

# ---- Variant 3: control — the conda aws-nccl module exactly as shipped ------
for v in "${EXTRA_FI[@]}"; do unset "$v"; done
unset NCCL_NET NCCL_NET_GDR_LEVEL NCCL_CROSS_NIC NCCL_COLLNET_ENABLE
module unload conda/2025-09-25 2>/dev/null
module load conda/2025-09-25-aws-nccl-1.6.0
# shellcheck disable=SC1091
conda activate base
run_variant "module-1.6.0" 29703

echo
echo "AB_DONE nodes=${NNODES}"
